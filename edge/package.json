{
  "name": "telegram-assistant-edge",
  "version": "1.0.0",
  "description": "Telegram Edge webhook handler component",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "dev": "node --experimental-strip-types --watch server.ts",
    "test": "node --test --experimental-strip-types",
    "webhook:info": "node --experimental-strip-types register_webhook.ts info",
    "webhook:set": "node --experimental-strip-types register_webhook.ts set",
    "webhook:delete": "node --experimental-strip-types register_webhook.ts delete"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
