# ==========================================
# Telegram Edge Configuration
# ==========================================
# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Webhook secret token sent in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=replace_with_a_secure_random_webhook_secret

# The single authorized Telegram user ID (numeric integer)
ALLOWED_USER_ID=123456789

# Backend base URL for edge to forward normalized requests
BACKEND_URL=http://localhost:8000

# Shared secret for edge-to-backend authentication (Bearer token)
EDGE_BACKEND_SECRET=replace_with_a_secure_random_backend_secret

# Edge server port (when running in standalone mode)
EDGE_PORT=8080

# Optional secret for callback signing in asynchronous/long-run mode
CALLBACK_SIGNING_SECRET=replace_with_optional_hmac_signing_secret


# ==========================================
# FastAPI Backend Configuration
# ==========================================
# Backend server binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Model Provider: "anthropic" or "openai"
MODEL_PROVIDER=anthropic

# Provider API Keys & Model IDs
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Run limits and budgets
RUN_DEADLINE_SECONDS=25
MAX_MODEL_TURNS=6
MAX_TOOL_CALLS=8
MAX_PROMPT_LENGTH=4000

# Shared Storage URL (e.g. SQLite database or Postgres)
SHARED_STORAGE_URL=sqlite+aiosqlite:///./data/assistant.db

# MCP Configuration path
MCP_CONFIG_PATH=./mcp_config.json
